rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /*
     * Mutual Transfer identity boundary.
     *
     * Self-declared identity may be created/updated only by the
     * authenticated Firebase user who owns the document.
     *
     * The client can never create or promote an identity to VERIFIED,
     * and cannot write verifiedServiceNo or verifiedGrade.
     */
    match /transferIdentities/{userId} {
      allow read: if request.auth != null
        && request.auth.uid == userId;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.firebaseUid == request.auth.uid
        && request.resource.data.verificationMethod == 'SELF_DECLARED'
        && !request.resource.data.keys().hasAny([
          'verifiedServiceNo',
          'verifiedGrade'
        ]);

      allow update: if request.auth != null
        && request.auth.uid == userId
        && resource.data.firebaseUid == request.auth.uid
        && request.resource.data.firebaseUid == request.auth.uid
        && resource.data.verificationMethod == 'SELF_DECLARED'
        && request.resource.data.verificationMethod == 'SELF_DECLARED'
        && !request.resource.data.keys().hasAny([
          'verifiedServiceNo',
          'verifiedGrade'
        ]);
    }

    /*
     * Transfer profiles are deliberately not client-writable/readable yet.
     *
     * Publication will be opened only through the authoritative
     * verification/server boundary in a later incremental step.
     */
    match /transferProfiles/{serviceNo} {
      allow read, write: if false;
    }

    /*
     * Nurse's active Mutual Transfer request.
     *
     * Privacy & Security invariants:
     * - Global collection queries (listing) are denied to prevent pool enumeration.
     * - A nurse can ONLY get/read their own request.
     * - A client can create a request ONLY with initial status 'SEARCHING', locked=false, and no matchId.
     * - A client CANNOT forge locked=true, currentMatchId, or create MATCHED/MATCH_PENDING requests.
     * - Preferences and hospital are client-controlled while not locked.
     * - Status can only remain 'SEARCHING' or transition to 'WITHDRAWN' by client.
     * - Grade is matching metadata; same-grade is NOT enforced as a hard rule.
     * - Deletion/withdrawal is allowed only when the request is not locked in an active match.
     */
    match /transferRequests/{userId} {
      allow get: if request.auth != null
        && request.auth.uid == userId;

      allow list: if false;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.firebaseUid == request.auth.uid
        && request.resource.data.status == 'SEARCHING'
        && request.resource.data.locked == false
        && request.resource.data.currentMatchId == null
        && request.resource.data.currentHospitalId is string
        && request.resource.data.currentHospitalId.size() > 0
        && request.resource.data.preferenceHospitalIds is list
        && request.resource.data.preferenceHospitalIds.size() >= 1
        && request.resource.data.preferenceHospitalIds.size() <= 3
        && request.resource.data.grade is string
        && request.resource.data.grade.size() > 0;

      allow update: if request.auth != null
        && request.auth.uid == userId
        && resource.data.firebaseUid == request.auth.uid
        && request.resource.data.firebaseUid == request.auth.uid
        && resource.data.locked == false
        && request.resource.data.locked == false
        && request.resource.data.currentMatchId == resource.data.currentMatchId
        && (request.resource.data.status == 'SEARCHING' || request.resource.data.status == 'WITHDRAWN')
        && request.resource.data.currentHospitalId is string
        && request.resource.data.currentHospitalId.size() > 0
        && request.resource.data.preferenceHospitalIds is list
        && request.resource.data.preferenceHospitalIds.size() >= 1
        && request.resource.data.preferenceHospitalIds.size() <= 3
        && request.resource.data.grade is string
        && request.resource.data.grade.size() > 0;

      allow delete: if request.auth != null
        && request.auth.uid == userId
        && resource.data.locked == false;
    }

    /*
     * Authoritative Mutual Transfer Matches.
     *
     * Invariants:
     * - Created, locked, and finalized exclusively by the trusted matching engine (Cloudflare Worker).
     * - Clients CANNOT create or delete match documents.
     * - Global collection queries (listing) are denied to prevent snooping.
     * - A nurse can get/read a match ONLY if they are nurseAUid or nurseBUid.
     * - Participants CANNOT change participants, match status, createdAt, expiresAt, or grade metadata.
     * - Participants may ONLY update their own acceptance/rejection flag.
     * - Same-grade is NOT enforced by the rules; cross-grade matching remains eligible.
     */
    match /matches/{matchId} {
      allow get: if request.auth != null
        && (
          request.auth.uid == resource.data.nurseAUid
          || request.auth.uid == resource.data.nurseBUid
          || (resource.data.keys().hasAny(['nurseCUid']) && request.auth.uid == resource.data.nurseCUid)
        );

      allow list: if false;

      allow create, delete: if false;

      allow update: if request.auth != null
        && (
          (
            request.auth.uid == resource.data.nurseAUid
            && request.resource.data.nurseAUid == resource.data.nurseAUid
            && request.resource.data.nurseBUid == resource.data.nurseBUid
            && request.resource.data.status == resource.data.status
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.expiresAt == resource.data.expiresAt
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acceptedByA', 'rejectedByA', 'updatedAt'])
          )
          ||
          (
            request.auth.uid == resource.data.nurseBUid
            && request.resource.data.nurseAUid == resource.data.nurseAUid
            && request.resource.data.nurseBUid == resource.data.nurseBUid
            && request.resource.data.status == resource.data.status
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.expiresAt == resource.data.expiresAt
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acceptedByB', 'rejectedByB', 'updatedAt'])
          )
        );

      /*
       * Mutual Transfer Chat Messages Subcollection.
       *
       * Privacy, Security, & Workflow Invariants:
       * - Scoped strictly to /matches/{matchId}/messages/{messageId}.
       * - Only authenticated participants (A, B, and C if 3-way) of the parent match may read or create.
       * - Reads allowed for participants across active, confirmed, cancelled, and expired states.
       * - Message creation allowed ONLY when parent match.status == 'CHAT_OPEN'.
       * - Message creation allowed ONLY before match authoritative chatDeadline has passed.
       * - Sender identity enforced: senderUid must match request.auth.uid.
       * - matchId and messageId must match the document path.
       * - Text must be a string, non-empty after trimming, <= 500 characters, no attachments.
       * - senderHospitalId and senderGrade must be valid strings.
       * - Timestamp is strictly bound to server time (request.time).
       * - Messages are strictly immutable: updates and deletions are denied.
       */
      match /messages/{messageId} {
        function getMatchData() {
          return get(/databases/$(database)/documents/matches/$(matchId)).data;
        }

        function isMatchParticipant(matchData) {
          return request.auth != null && (
            request.auth.uid == matchData.nurseAUid ||
            request.auth.uid == matchData.nurseBUid ||
            (matchData.keys().hasAny(['nurseCUid']) && request.auth.uid == matchData.nurseCUid)
          );
        }

        function isBeforeDeadline(matchData) {
          return matchData.keys().hasAny(['chatDeadlineMs'])
            ? (matchData.chatDeadlineMs is int && request.time < timestamp.value(matchData.chatDeadlineMs))
            : (
                matchData.keys().hasAny(['expiresAtMs'])
                  ? (matchData.expiresAtMs is int && request.time < timestamp.value(matchData.expiresAtMs))
                  : (
                      matchData.keys().hasAny(['chatDeadline']) && matchData.chatDeadline is timestamp
                        ? request.time < matchData.chatDeadline
                        : (
                            matchData.keys().hasAny(['expiresAt']) && matchData.expiresAt is timestamp
                              ? request.time < matchData.expiresAt
                              : false
                          )
                    )
              );
        }

        allow read: if isMatchParticipant(getMatchData());

        allow create: if isMatchParticipant(getMatchData())
          && getMatchData().status == 'CHAT_OPEN'
          && isBeforeDeadline(getMatchData())
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.matchId == matchId
          && request.resource.data.messageId == messageId
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.text.matches('.*\\S.*')
          && request.resource.data.senderHospitalId is string
          && request.resource.data.senderHospitalId.size() > 0
          && request.resource.data.senderGrade is string
          && request.resource.data.senderGrade.size() > 0
          && request.resource.data.createdAt == request.time
          && request.resource.data.keys().hasOnly([
            'messageId', 'matchId', 'senderUid', 'senderHospitalId',
            'senderGrade', 'text', 'createdAt'
          ]);

        allow update, delete: if false;
      }
    }

    /*
     * Deny every other collection until its explicit security contract
     * is implemented.
     */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
